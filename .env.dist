# ваш зарегистрированный домен, на котором будет работать сайт
DOMAIN=your.domain
EMAIL=your@email.com

# Панель опубликована только на 127.0.0.1. Доступ через SSH-туннель.
UI_PORT=4242
UI_DUMMY_PATH=dummy
UI_PATH=path

# внутренний порт xray, не публикуется наружу
NETWORK_PORT=22443
# путь без начального/конечного слеша
NETWORK_PATH=placeyourpath

# xhttp по умолчанию. ws оставлен для управляемой миграции/отката
NETWORK_TRANSPORT=xhttp
# браузерный ClientHello. Проверяйте поддержку в ядре клиентского приложения
TLS_FINGERPRINT=firefox

# ссылки создают make 3xui-export-links и make 3xui-add-client.
# XHTTP: mode=stream-up, alpn=h2. WS: alpn=http/1.1.
# TLS завершается на nginx; сертификат на клиенте обязательно проверяется.
